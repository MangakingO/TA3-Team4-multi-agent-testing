---
config:
  layout: elk
---
flowchart TB
    START(( )):::start
    subgraph design["Steps 1-4: design the test cases"]
        direction TB
        setup["<b>setup</b><br/>compile, observe, analyze"]:::tool
        ep_agent["<b>ep_agent</b><br/>step 1: EP test cases"]:::agent
        bva_agent["<b>bva_agent</b><br/>step 1: BVA test cases"]:::agent
        curate["<b>curate</b><br/>steps 2-3: join, remove duplicates"]:::tool
        review_tests["<b>review_tests</b><br/>step 4: the tester reviews"]:::person
        revise_tests["<b>revise_tests</b><br/>step 4: the reviser applies changes"]:::agent
    end
    subgraph test["Steps 5-7 and 10-12: test, repair, cover (original, then refactored code)"]
        direction TB
        run_tests["<b>run_tests</b><br/>steps 5, 10: mvn test"]:::tool
        repair["<b>repair</b><br/>step 6: fix the code or the test, log it"]:::agent
        measure_coverage["<b>measure_coverage</b><br/>steps 7, 11: JaCoCo branch coverage"]:::tool
        coverage_gap["<b>coverage_gap</b><br/>steps 7, 12: tests for missed branches"]:::agent
        ask_human["<b>ask_human</b><br/>a loop reached its limit"]:::person
    end
    subgraph refactoring["Steps 8-10: refactor and reuse the tests"]
        direction TB
        refactor["<b>refactor</b><br/>step 8: State pattern, final prompt P3"]:::agent
        review_refactoring["<b>review_refactoring</b><br/>step 9: the team reviews"]:::person
        recheck_refactoring["<b>recheck_refactoring</b><br/>step 9: compile, javap checks"]:::tool
        adapt_tests["<b>adapt_tests</b><br/>step 10: reuse, adapt or remove tests"]:::agent
    end
    finalize["<b>finalize</b><br/>save results, summary.md, final/"]:::tool
    END((( ))):::stop
    START --> setup
    setup --> ep_agent
    setup --> bva_agent
    ep_agent --> curate
    bva_agent --> curate
    curate --> review_tests
    revise_tests --> review_tests
    repair --> run_tests
    coverage_gap --> run_tests
    recheck_refactoring --> review_refactoring
    adapt_tests --> run_tests
    finalize --> END
    review_tests -. "accepted" .-> run_tests
    review_tests -. "changes requested" .-> revise_tests
    run_tests -. "all pass" .-> measure_coverage
    run_tests -. "failures" .-> repair
    run_tests -. "repair limit or build error" .-> ask_human
    measure_coverage -. "100%, original code" .-> refactor
    measure_coverage -. "100%, refactored code" .-> finalize
    measure_coverage -. "branch coverage < 100%" .-> coverage_gap
    measure_coverage -. "coverage limit" .-> ask_human
    refactor -. "compile errors: retry" .-> refactor
    refactor -. "compiles" .-> review_refactoring
    review_refactoring -. "accepted" .-> adapt_tests
    review_refactoring -. "feedback or edited prompt" .-> refactor
    review_refactoring -. "code edited" .-> recheck_refactoring
    ask_human -. "continue" .-> run_tests
    ask_human -. "stop" .-> finalize
    classDef agent fill:#EDE9FE,stroke:#7C3AED,stroke-width:1.5px,color:#0F172A
    classDef person fill:#FEF3C7,stroke:#D97706,stroke-width:1.5px,color:#0F172A
    classDef tool fill:#E2E8F0,stroke:#475569,stroke-width:1.5px,color:#0F172A
    classDef start fill:#0F172A,stroke:#0F172A
    classDef stop fill:#0F172A,stroke:#0F172A
    style design fill:#F8FAFC,stroke:#CBD5E1,stroke-width:1.4px,color:#0F172A
    style test fill:#F8FAFC,stroke:#CBD5E1,stroke-width:1.4px,color:#0F172A
    style refactoring fill:#F8FAFC,stroke:#CBD5E1,stroke-width:1.4px,color:#0F172A

