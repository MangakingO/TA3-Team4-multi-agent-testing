# Copy to .env (in this folder) and adjust. Every value has a default; this file only overrides them.
# A real environment variable wins over the same name in .env.

# ---- language model ---------------------------------------------------------------
# ollama (default): local model through Ollama 0.5 or later (ollama pull qwen2.5-coder:7b)
# manual: every prompt is written to runs/<run>/llm/NNN-<agent>.prompt.md; paste it into any web
#         LLM and save its answer as the matching .response.md, then resume the run
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
# REFACTOR_MODEL=qwen2.5-coder:14b      # optional bigger model just for the refactoring agent
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0
LLM_NUM_CTX=32768
LLM_NUM_PREDICT=16384
LLM_TIMEOUT=3600
# MANUAL_MODEL=ChatGPT (GPT-5)          # with LLM_PROVIDER=manual: which web LLM you relay (recorded in the run)

# ---- Java build of the code under test ------------------------------------------------
MVN=mvn                                 # on Windows the system finds mvn.cmd automatically
# MAVEN_ARGS=-o                         # extra Maven options, e.g. offline after the first build
MAVEN_TIMEOUT=900
POM_TEMPLATE=season-switch/pom.xml      # copied into every Maven project the agents create
TEST_TIMEOUT_SECONDS=10                 # JUnit @Timeout for each test

# ---- observing the program in setup (What To Do, item 2) ---------------------------
# one run per ';'-separated item; an empty item = no arguments; each run stops after OBSERVE_SECONDS
OBSERVE_ARGS=;cool;heat;off;warm
OBSERVE_SECONDS=4

# ---- where things are ---------------------------------------------------------------
# RUNS_DIR=runs                         # one folder per run
# PROMPTS_DIR=prompts                   # the agents' prompt templates
# REFACTOR_PROMPT=prompts/refactor_state_pattern.md

# ---- loop limits (a person decides when one is reached) ------------------------------
MAX_REPAIR_ROUNDS=6
MAX_COVERAGE_ROUNDS=4
MAX_REFACTOR_ATTEMPTS=3
TARGET_BRANCH_COVERAGE=100
